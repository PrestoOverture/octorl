+def compute_sign_outcome_advantage(
+    token_level_rewards: torch.Tensor,
+    response_mask: torch.Tensor,
+    index: np.ndarray,
+    trajectory_uids: np.ndarray,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Use the fixed-reference binary advantage ``2 * reward - 1``.
+
+    Unlike GRPO, this estimator neither centers nor normalizes within prompt
+    groups.  It therefore preserves a learning signal for homogeneous G=4
+    groups.  Binary reward validation is intentionally strict so a wiring
+    regression cannot silently create intermediate advantages.
+    """
+    with torch.no_grad():
+        step_scores, traj2total_score, _ = _trajectory_total_scores(
+            token_level_rewards=token_level_rewards,
+            response_mask=response_mask,
+            index=index,
+            trajectory_uids=trajectory_uids,
+        )
+
+        traj2adv: dict[object, torch.Tensor] = {}
+        for traj_uid, total_score in traj2total_score.items():
+            if not torch.isfinite(total_score):
+                raise ValueError(f"non-finite Sign reward for trajectory {traj_uid!r}")
+            rounded = torch.round(total_score)
+            if not torch.isclose(total_score, rounded, atol=1e-6, rtol=0.0) or not (
+                0.0 <= rounded.item() <= 1.0
+            ):
+                raise ValueError(
+                    "Sign advantage requires binary trajectory rewards in {0, 1}; "
+                    f"trajectory {traj_uid!r} has {total_score.item()}"
+                )
+            traj2adv[traj_uid] = 2.0 * rounded - 1.0
+
+        scores = step_scores.clone()
+        for row in range(step_scores.shape[0]):
+            scores[row] = traj2adv[trajectory_uids[row]]
+        scores = scores.unsqueeze(-1) * response_mask
+
+        valid = scores[response_mask.to(dtype=torch.bool)]
+        if valid.numel() == 0 or not torch.all((valid == -1.0) | (valid == 1.0)):
+            raise AssertionError("Sign advantages must be exactly -1 or +1")
+
+    return scores, scores
+
