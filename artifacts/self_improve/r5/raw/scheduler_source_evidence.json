        "text": "    stable_ratio: float = 0.9,"
      },
      {
        "line": 831,
        "text": "):"
      },
      {
        "line": 832,
        "text": "    \"\"\""
      },
      {
        "line": 833,
        "text": "    Create a Warmup-Stable-Decay learning rate scheduler."
      },
      {
        "line": 840,
        "text": "    Args:"
      },
      {
        "line": 841,
        "text": "        optimizer (:class:`~torch.optim.Optimizer`):"
      },
      {
        "line": 842,
        "text": "            The optimizer for which to schedule the learning rate."
      },
      {
        "line": 843,
        "text": "        num_warmup_steps (:obj:`int`):"
      },
      {
        "line": 844,
        "text": "            The number of steps for the warmup phase."
      },
      {
        "line": 845,
        "text": "        num_training_steps (:obj:`int`):"
      },
      {
        "line": 846,
        "text": "            The total number of training steps."
      },
      {
        "line": 847,
        "text": "        min_lr_ratio (:obj:`float`, `optional`, defaults to 0.0):"
      },
      {
        "line": 848,
        "text": "            The minimum learning rate ratio w.r.t the initial learning rate."
      },
      {
        "line": 849,
        "text": "        num_cycles (:obj:`float`, `optional`, defaults to 0.5):"
      },
      {
        "line": 850,
        "text": "            The number of waves in the cosine schedule during decay phase."
      },
      {
        "line": 851,
        "text": "        last_epoch (:obj:`int`, `optional`, defaults to -1):"
      },
      {
        "line": 852,
        "text": "            The index of the last epoch when resuming training."
      },
      {
        "line": 855,
        "text": "            Set to 0.0 to behave exactly like cosine schedule."
      },
      {
        "line": 856,
        "text": ""
      },
      {
        "line": 857,
        "text": "    Return:"
      },
      {
        "line": 858,
        "text": "        :obj:`torch.optim.lr_scheduler.LambdaLR` with the appropriate schedule."
      },
      {
        "line": 859,
        "text": "    \"\"\""
      },
      {
        "line": 860,
        "text": "    remaining_steps = max(0, num_training_steps - num_warmup_steps)"
      },
      {
        "line": 861,
        "text": "    num_stable_steps = int(remaining_steps * stable_ratio)"
      },
      {
        "line": 862,
        "text": "    num_decay_steps = remaining_steps - num_stable_steps"
      },
      {
        "line": 863,
        "text": ""
      },
      {
        "line": 864,
        "text": "    def lr_lambda(current_step):"
      },
      {
        "line": 865,
        "text": "        if current_step < num_warmup_steps:"
      },
      {
        "line": 866,
        "text": "            return float(current_step) / float(max(1, num_warmup_steps))"
      },
      {
        "line": 867,
        "text": "        if current_step < num_warmup_steps + num_stable_steps:"
      },
      {
        "line": 868,
        "text": "            return 1.0"
      },
      {
        "line": 869,
        "text": "        if current_step < num_training_steps:"
      },
      {
        "line": 870,
        "text": "            progress = float(current_step - num_warmup_steps - num_stable_steps) / float(max(1, num_decay_steps))"
      },
      {
        "line": 871,
        "text": "            value = max(0.0, 0.5 * (1.0 + math.cos(math.pi * float(num_cycles) * 2.0 * progress)))"
      },
      {
        "line": 872,
        "text": "            return (1.0 - min_lr_ratio) * value + min_lr_ratio"
      },
      {
        "line": 873,
        "text": "        return min_lr_ratio"
      },
