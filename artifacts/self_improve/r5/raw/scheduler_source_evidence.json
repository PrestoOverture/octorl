      {
        "line": 685,
        "text": "def get_cosine_schedule_with_warmup("
      },
      {
        "line": 686,
        "text": "    optimizer: Optimizer,"
      },
      {
        "line": 687,
        "text": "    num_warmup_steps: int,"
      },
      {
        "line": 688,
        "text": "    num_training_steps: int,"
      },
      {
        "line": 689,
        "text": "    min_lr_ratio: float = 0.0,"
      },
      {
        "line": 690,
        "text": "    num_cycles: float = 0.5,"
      },
      {
        "line": 691,
        "text": "    last_epoch: int = -1,"
      },
      {
        "line": 692,
        "text": "    init_lr_ratio: float = None,"
      },
      {
        "line": 693,
        "text": "):"
      },
      {
        "line": 694,
        "text": "    \"\"\""
      },
      {
        "line": 695,
        "text": "    Create a schedule with a learning rate that decreases following the values of the cosine function between the"
      },
      {
        "line": 698,
        "text": "    Args:"
      },
      {
        "line": 699,
        "text": "        optimizer (:class:`~torch.optim.Optimizer`):"
      },
      {
        "line": 700,
        "text": "            The optimizer for which to schedule the learning rate."
      },
      {
        "line": 701,
        "text": "        num_warmup_steps (:obj:`int`):"
      },
      {
        "line": 702,
        "text": "            The number of steps for the warmup phase."
      },
      {
        "line": 703,
        "text": "        num_training_steps (:obj:`int`):"
      },
      {
        "line": 704,
        "text": "            The total number of training steps."
      },
      {
        "line": 705,
        "text": "        min_lr_ratio (:obj:`float`, `optional`, defaults to 0.0):"
      },
      {
        "line": 706,
        "text": "            The minimum lr ratio w.r.t the maximum."
      },
      {
        "line": 707,
        "text": "        num_cycles (:obj:`float`, `optional`, defaults to 0.5):"
      },
      {
        "line": 708,
        "text": "            The number of waves in the cosine schedule (the defaults is to just decrease from the max value to 0"
      },
      {
        "line": 709,
        "text": "            following a half-cosine)."
      },
      {
        "line": 710,
        "text": "        last_epoch (:obj:`int`, `optional`, defaults to -1):"
      },
      {
        "line": 723,
        "text": "    assert init_lr_ratio >= 0 and init_lr_ratio <= 1.0"
      },
      {
        "line": 724,
        "text": ""
      },
      {
        "line": 725,
        "text": "    def lr_lambda(current_step):"
      },
      {
        "line": 726,
        "text": "        if current_step < num_warmup_steps:"
      },
      {
        "line": 727,
        "text": "            return init_lr_ratio + (1.0 - init_lr_ratio) * (float(current_step) / float(max(1, num_warmup_steps)))"
