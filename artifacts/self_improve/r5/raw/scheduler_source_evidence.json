      {
        "line": 734,
        "text": ""
      },
      {
        "line": 735,
        "text": "def get_constant_schedule_with_warmup("
      },
      {
        "line": 821,
        "text": ""
      },
      {
        "line": 822,
        "text": ""
      },
      {
        "line": 823,
        "text": "def get_wsd_schedule_with_warmup("
      },
      {
        "line": 824,
        "text": "    optimizer: Optimizer,"
      },
      {
        "line": 825,
        "text": "    num_warmup_steps: int,"
      },
      {
        "line": 826,
        "text": "    num_training_steps: int,"
      },
      {
        "line": 827,
        "text": "    min_lr_ratio: float = 0.0,"
      },
      {
